# Copy to .env and fill in.
PORT=8080
# 32+ char random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Data source adapter: "sample" (seeded demo data) or "sheet" (Google Sheet CSV import)
DATA_ADAPTER=sample
# For DATA_ADAPTER=sheet: a published/exported CSV URL with the sales columns (see BACKEND_REQUIREMENTS.md)
SALES_CSV_URL=
# How often (minutes) to re-import from SALES_CSV_URL (0 = manual only)
IMPORT_INTERVAL_MIN=0
# Set true behind a TLS-terminating proxy (Caddy/Cloudflare) so secure cookies are sent
TRUST_PROXY=false
